{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinniped-concierge",
  "type": "object",
  "required": ["image", "replicaCount"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "concierge": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": { "type": "object" }
          }
        },
        "kubeCertAgent": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" }
          }
        },
        "impersonationProxy": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "annotations": { "type": "object" }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "apiService": {
      "type": "object",
      "properties": {
        "groupPriorityMinimum": { "type": "integer" },
        "versionPriority": { "type": "integer" }
      }
    },
    "config": { "type": "object" },
    "credentialIssuer": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "impersonationProxy": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["auto", "enabled", "disabled"] },
            "service": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
                "annotations": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "certificate": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" },
        "clusterIssuer": { "type": "string" },
        "secretName": { "type": "string" },
        "duration": { "type": "string" },
        "renewBefore": { "type": "string" }
      }
    },
    "jwtAuthenticators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string" },
          "audience": { "type": "string" },
          "claims": {
            "type": "object",
            "properties": {
              "username": { "type": "string" },
              "groups": { "type": "string" },
              "usernameExpression": { "type": "string" },
              "groupsExpression": { "type": "string" },
              "extra": { "type": "array" }
            }
          },
          "tls": { "type": "object" },
          "claimValidationRules": { "type": "array" },
          "userValidationRules": { "type": "array" }
        }
      }
    },
    "webhookAuthenticators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string" },
          "tls": { "type": "object" }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "extraManifests": { "type": "array" }
  }
}
